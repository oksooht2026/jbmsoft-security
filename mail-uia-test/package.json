{
  "name": "oksoo-mail-uia-test",
  "version": "1.0.0",
  "description": "메일 UIA 감사 기능 단독 테스트",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "author": "OKSOOHT",
  "license": "UNLICENSED",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.oksoohitech.mail-uia-test",
    "productName": "OKSOOHT 메일UIA 테스트",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "mail-uia-monitor.js",
      "mail-uia-scrape.ps1"
    ],
    "win": {
      "target": "nsis",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "MailUIA_Test_Setup.${ext}",
      "createDesktopShortcut": true,
      "shortcutName": "메일UIA 테스트"
    }
  }
}
