{
  "manifest_version": 3,
  "name": "OKSOOHT Security Mail Logger",
  "version": "1.0.0",
  "description": "옥수하이테크 보안솔루션 — 웹메일 발송 감사 로그 수집",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "webRequest"
  ],
  "host_permissions": [
    "*://mail.naver.com/*",
    "*://*.worksmobile.com/*",
    "*://mail.worksmobile.com/*",
    "*://mail.google.com/*",
    "*://*.daouoffice.com/*",
    "*://mail.daum.net/*",
    "*://*.outlook.com/*",
    "*://*.office365.com/*",
    "*://*.office.com/*",
    "*://mail.kakao.com/*",
    "*://*/*mail*/*",
    "*://*/*groupware*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://mail.naver.com/*",
        "*://*.worksmobile.com/*",
        "*://mail.worksmobile.com/*",
        "*://mail.google.com/*",
        "*://*.daouoffice.com/*",
        "*://mail.daum.net/*",
        "*://*.outlook.com/*",
        "*://*.office365.com/*",
        "*://*.office.com/*",
        "*://mail.kakao.com/*",
        "*://*/*mail*/*",
        "*://*/*groupware*/*"
      ],
      "js": ["lib/mail-parser.js", "content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
