{
  "name": "oksoo-security",
  "version": "1.0.0",
  "description": "옥수하이테크 보안 솔루션",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder --win"
  },
  "keywords": [
    "security",
    "jbmsoft",
    "enterprise"
  ],
  "author": "JBMSOFT",
  "license": "UNLICENSED",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^26.8.1"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "chokidar": "^3.5.3",
    "electron-store": "^5.2.0",
    "uuid": "^9.0.0",
    "winreg": "^1.2.5"
  },
  "build": {
    "appId": "com.oksoohitech.security",
    "productName": "옥수하이테크 보안솔루션",
    "copyright": "Copyright © 2026 JBM SOFT",
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "OksooSecurity_Setup.${ext}",
      "include": "build/installer.nsh"
    }
  }
}
